# Copy to ~/robot_brain/.env  (never commit the real file). Placeholders only.
GEMINI_API_KEY=
# Models (names provisional - run tools/check_gemini.py to see which exist for your key)
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_VOICE=Kore

# Microphone: INMP441 via ALSA (the value that already worked on Aurora)
ALSA_CAPTURE_DEVICE=plughw:2,0
SAMPLE_RATE=16000

# Bluetooth speaker. MAC optional but recommended (find with: bluetoothctl devices)
BT_SPEAKER_MAC=
AUDIO_BACKEND=auto
# AUDIO_SINK=bluez_output.XX_XX_XX_XX_XX_XX.1
# Mouth/subtitle delay after the first byte is written (increase if the mouth moves BEFORE the sound, decrease if after)
OUTPUT_LATENCY_MS=350
OUTPUT_LEAD_SILENCE_MS=400

# Touch sensor (TTP223)
TOUCH_PIN=17
TOUCH_HOLD_S=2.5
TOUCH_TO_TALK=auto

# Wake word (needs the vosk package + model dir)
ENABLE_WAKE_WORD=true
WAKE_WORDS=hey nova,nova
VOSK_MODEL_PATH=/home/pi/robot_brain/models/vosk-model
FOLLOWUP_SECONDS=5

ENABLE_CAMERA=false
HUMMING_ENABLED=true
